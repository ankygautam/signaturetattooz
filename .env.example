# Local Vite environment file for the browser app.
# These values are Firebase web-client config, not server secrets.
# Keep the real `.env` out of Git and use this file as the template.
#
# Admin access also requires:
# 1. Firebase Auth Email/Password sign-in enabled
# 2. Firestore rules deployed
# 3. `admins/<uid>` document present with `role = "admin"`

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=G-3T87G0H4VS
