rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function adminDocPath() {
      return /databases/(default)/documents/admins/$(request.auth.uid);
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(adminDocPath())
        && firestore.get(adminDocPath()).data.role == "admin";
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
